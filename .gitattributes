# Normalise line endings: LF in the repository and in every checkout (the shell scripts must stay LF).
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf

# Binary assets
*.mp3 binary
*.ogg binary
*.wav binary
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary

# Generated
package-lock.json linguist-generated=true -diff
